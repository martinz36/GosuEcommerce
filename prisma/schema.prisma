datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// USER, NEXTAUTH & AFFILIATES SYSTEM
// ------------------------------------------------------
enum Role {
  CUSTOMER
  AFFILIATE
  ADMIN
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String          @unique
  emailVerified    DateTime?
  image            String?         // NextAuth avatar URL
  passwordHash     String?
  firstName        String?
  lastName         String?
  phone            String?
  avatarUrl        String?         // Cloudinary URL
  role             Role            @default(CUSTOMER)
  loyaltyPoints    Int             @default(0) // Puntos de fidelidad acumulados por compras
  birthdate        DateTime?
  isProfileCompleted Boolean         @default(false)
  
  // Relaciones NextAuth
  accounts         Account[]
  sessions         Session[]

  // Sistema de Referidos (Usuario invita Usuario)
  referralCode     String?         @unique
  referredById     String?
  referredBy       User?           @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]          @relation("UserReferrals")
  
  // Relaciones E-commerce
  addresses        Address[]
  orders           Order[]
  createdDiscounts DiscountCode[]   @relation("CreatedByAffiliate")
  commissions      CommissionLog[] @relation("AffiliateCommissions")

  // Métricas de Afiliado
  totalSalesGenerated Decimal       @default(0.00) @db.Decimal(10, 2)
  pendingCommission   Decimal       @default(0.00) @db.Decimal(10, 2)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String
  city         String
  state        String
  postalCode   String
  country      String
  isDefault    Boolean  @default(false)
  
  orders       Order[]  @relation("ShippingAddress")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------------------------------------------------------
// REGIONES Y MULTI-MONEDA DINÁMICA (Vercel Geo + Neon DB)
// ------------------------------------------------------
model RegionConfig {
  id                 String           @id @default(cuid())
  countryCode        String           @unique // Ej: 'PE', 'US', 'CO', 'MX'
  countryName        String           // Ej: 'Perú', 'Estados Unidos'
  currency           String           // Ej: 'PEN', 'USD'
  currencySymbol     String           @default("$") // Ej: 'S/.', '$'
  exchangeRate       Decimal          @default(1.00) @db.Decimal(10, 4) // Tasa de cambio respecto a USD
  isActive           Boolean          @default(true)
  isDefault          Boolean          @default(false) // Región por defecto (Rest of World / US)
  isAutoExchangeRate Boolean          @default(false) // Tasa dinámica automática vs fija manual
  
  shippingMethods    ShippingMethod[] // Métodos de envío específicos de la región

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ------------------------------------------------------
// MÉTODOS DE ENVÍO Y METAS POR REGIÓN
// ------------------------------------------------------
model ShippingMethod {
  id                    String       @id @default(cuid())
  name                  String       // Ej: "Envío Estándar (Olva)", "USPS Priority"
  cost                  Decimal      @db.Decimal(10, 2)
  freeShippingThreshold Decimal?     @db.Decimal(10, 2) // Meta de compra para envío gratis en esta región
  isActive              Boolean      @default(true)

  // Sub-Zonas y Recojo en Tienda (Local Pickup)
  targetZones           Json?        // Array de departamentos/provincias elegibles o null para todo el país
  isPickup              Boolean      @default(false) // Indica si es método de Recojo en Tienda
  pickupAddress         String?      // Dirección física para el recojo
  pickupSchedule        String?      // Horarios de atención

  regionId              String
  region                RegionConfig @relation(fields: [regionId], references: [id], onDelete: Cascade)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

// ------------------------------------------------------
// CONFIGURACIÓN GLOBAL DE LA TIENDA
// ------------------------------------------------------
model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("GOSU® TCG")
  freeShippingThreshold Decimal  @default(50.00) @db.Decimal(10, 2)
  standardShippingCost  Decimal  @default(4.99) @db.Decimal(10, 2)
  currency              String   @default("USD")
  updatedAt             DateTime @updatedAt
}

// ------------------------------------------------------
// CARRITOS ABANDONADOS (CartSession)
// ------------------------------------------------------
model CartSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  userId       String?
  userEmail    String?
  itemsJson    Json     // Array de productos guardados temporalmente
  subtotal     Decimal  @db.Decimal(10, 2)
  isConverted  Boolean  @default(false) // true cuando se transforma en Order
  lastActiveAt DateTime @default(now()) @updatedAt
  createdAt    DateTime @default(now())
}

// ------------------------------------------------------
// PRODUCTS & CATEGORIES (Cloudinary & Excel Import Ready)
// ------------------------------------------------------
model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?    // Cloudinary URL
  
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")

  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  description       String

  // Precios Explícitos e Independientes por Moneda (Sin depender de conversiones en frontend)
  priceUSD          Decimal          @default(0.00) @db.Decimal(10, 2)
  pricePEN          Decimal          @default(0.00) @db.Decimal(10, 2)
  compareAtPriceUSD Decimal?         @db.Decimal(10, 2)
  compareAtPricePEN Decimal?         @db.Decimal(10, 2)
  costUSD           Decimal?         @db.Decimal(10, 2)
  costPEN           Decimal?         @db.Decimal(10, 2)

  // Mantener basePrice por compatibilidad
  basePrice         Decimal          @default(0.00) @db.Decimal(10, 2)
  compareAtPrice    Decimal?         @db.Decimal(10, 2)
  costPerItem       Decimal?         @db.Decimal(10, 2)

  sku               String           @unique
  barcode           String?
  stock             Int              @default(0)
  isActive          Boolean          @default(true)
  isFeatured        Boolean          @default(false)

  // Campos para Importación Excel & Familias/Variantes de Color
  uniqueId          String?          @unique // ID Unico del Excel
  isFamily          Boolean          @default(false) // Es Familia (SI/NO)
  familyId          String?          // ID Familia para agrupar variantes de color
  productType       String?          // Tipo (Sleeves, Binders, Toploaders)
  
  // Cloudinary Galería de Imágenes
  images            ProductImage[]
  
  categoryId        String
  category          Category         @relation(fields: [categoryId], references: [id])

  variants          ProductVariant[]
  bundleItems       BundleItem[]
  orderItems        OrderItem[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   // Cloudinary secure URL
  publicId  String   // Cloudinary public ID
  altText   String?
  position  Int      @default(0)

  createdAt DateTime @default(now())
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String      // Ej: "Matte Black / Japanese Size"
  sku            String      @unique
  price          Decimal     @db.Decimal(10, 2)
  stock          Int         @default(0)
  imageUrl       String?     // Cloudinary URL específica de variante

  orderItems     OrderItem[]
  bundleItems    BundleItem[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ------------------------------------------------------
// BUNDLES & PACKS (Promociones Agrupadas)
// ------------------------------------------------------
model Bundle {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  description    String
  bundlePrice    Decimal      @db.Decimal(10, 2)
  compareAtPrice Decimal?     @db.Decimal(10, 2)
  imageUrl       String?      // Cloudinary URL del Pack
  isActive       Boolean      @default(true)
  startDate      DateTime?
  endDate        DateTime?

  items          BundleItem[]
  orderItems     OrderItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model BundleItem {
  id          String          @id @default(cuid())
  bundleId    String
  bundle      Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int             @default(1)
}

// ------------------------------------------------------
// PROMOTIONS, REFERRALS & AFFILIATE CODES
// ------------------------------------------------------
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountCategory {
  PROMO       // Cupón estándar de tienda
  REFERRAL    // Descuento otorgado por programa de referidos
  AFFILIATE   // Código de creador/afiliado con comisión
}

model DiscountCode {
  id                String           @id @default(cuid())
  code              String           @unique // Ej: "GOSU10", "ALEX_TCG"
  type              DiscountType
  category          DiscountCategory @default(PROMO)
  value             Decimal          @db.Decimal(10, 2) // % o Monto Fijo
  minPurchaseAmount Decimal?         @db.Decimal(10, 2)
  maxDiscountAmount Decimal?         @db.Decimal(10, 2)
  usageLimit        Int?             // Máximo de usos globales
  usageCount        Int              @default(0)
  isActive          Boolean          @default(true)
  startDate         DateTime?
  endDate           DateTime?
  expiresAt         DateTime?
  
  // Afiliado o Creador dueño del código
  createdById       String?
  createdBy         User?            @relation("CreatedByAffiliate", fields: [createdById], references: [id], onDelete: SetNull)
  commissionRate    Decimal?         @default(10.00) @db.Decimal(5, 2) // % de comisión para el afiliado

  orders            Order[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ------------------------------------------------------
// ORDERS & STRIPE PAYMENTS ENGINE
// ------------------------------------------------------
enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id                      String         @id @default(cuid())
  orderNumber             String         @unique // Ej: "GOSU-10001"
  
  // Cliente (opcional para Guest Checkout)
  userId                  String?
  user                    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail              String?

  // Estado del Pedido y Stripe
  status                  OrderStatus    @default(PENDING)
  stripePaymentIntentId   String?        @unique
  stripeCheckoutSessionId String?        @unique

  // Desglose Financiero
  subtotal                Decimal        @db.Decimal(10, 2)
  discountAmount          Decimal        @default(0.00) @db.Decimal(10, 2)
  taxAmount               Decimal        @default(0.00) @db.Decimal(10, 2)
  shippingAmount          Decimal        @default(0.00) @db.Decimal(10, 2)
  totalAmount             Decimal        @db.Decimal(10, 2)

  // Descuento Aplicado
  discountCodeId          String?
  discountCode            DiscountCode?  @relation(fields: [discountCodeId], references: [id])

  // Envío y Seguimiento
  shippingAddressId       String?
  shippingAddress         Address?       @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  shippingAddressJson     Json?          // Snapshot de dirección en el momento de la compra
  trackingNumber          String?
  trackingUrl             String?

  items                   OrderItem[]
  commissions             CommissionLog[]

  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  bundleId        String?
  bundle          Bundle?         @relation(fields: [bundleId], references: [id])

  quantity        Int
  unitPrice       Decimal         @db.Decimal(10, 2)
  totalPrice      Decimal         @db.Decimal(10, 2)
}

model CommissionLog {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  affiliateId      String
  affiliate        User     @relation("AffiliateCommissions", fields: [affiliateId], references: [id])
  commissionAmount Decimal  @db.Decimal(10, 2)
  isPaid           Boolean  @default(false)
  paidAt           DateTime?

  createdAt        DateTime @default(now())
}

// ------------------------------------------------------
// MOTOR DE GAMIFICACIÓN Y FIDELIZACIÓN (GOSU LOYALTY)
// ------------------------------------------------------
enum LoyaltyActionType {
  PURCHASE
  ACCOUNT_CREATION
  PROFILE_COMPLETION
  PRODUCT_REVIEW
  BIRTHDAY
}

model LoyaltyTier {
  id            String   @id @default(cuid())
  name          String   // Ej. "Contender", "Meta Player", "GOSU Champion"
  minPoints     Int      @default(0)
  badgeImageUrl String?  // URL de la imagen de la insignia
  perks         String?  // Descripción de beneficios
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoyaltyEarningRule {
  id           String            @id @default(cuid())
  actionType   LoyaltyActionType @unique
  pointsReward Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

